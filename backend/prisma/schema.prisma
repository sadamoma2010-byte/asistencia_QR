// ──────────────────────────────────────────────────────────────
// Sistema Web de Asistencia Docente por QR
// Motor: PostgreSQL 16
//
// Convenciones del esquema:
//   · Identificadores UUID v4 generados por la base de datos
//   · Enumeraciones nativas del motor, no cadenas libres
//   · Longitudes acotadas con VARCHAR para que la restricción viva
//     también en la base y no solo en los DTO
//   · Soft delete obligatorio: `deletedAt` nulo significa vigente
//   · Auditoría con `metadata` en JSONB, consultable con operadores JSON
//
// Los índices priorizan los accesos reales del sistema: listados
// filtrados por estado, consultas de asistencia por docente y fecha,
// y búsqueda de la bitácora por módulo y periodo.
// ──────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════ Enumeraciones ═══════════════════════

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT

  @@map("attendance_type")
}

enum AttendanceStatus {
  /// PUNTUAL — RN008
  ON_TIME
  /// TARDE — RN007
  LATE
  /// SALIDA ANTICIPADA
  EARLY_DEPARTURE

  @@map("attendance_status")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  LOGIN
  LOGOUT
  ATTENDANCE

  @@map("audit_action")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON

  @@map("setting_type")
}

// ═════════════════════════ Usuarios ══════════════════════════

/// Cuentas de acceso al sistema.
model User {
  id        String  @id @default(uuid()) @db.Uuid
  firstName String  @map("first_name") @db.VarChar(120)
  lastName  String  @map("last_name") @db.VarChar(120)
  document  String  @unique @db.VarChar(40)
  email     String  @unique @db.VarChar(180)
  phone     String? @db.VarChar(30)
  /// Hash bcrypt: nunca se almacena la contraseña en claro
  password  String  @db.VarChar(255)

  status RecordStatus @default(ACTIVE)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  mustChangePassword  Boolean   @default(false) @map("must_change_password")

  teacher       Teacher?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, deletedAt])
  @@index([roleId])
  @@index([email])
  @@map("users")
}

/// Tokens de renovación de sesión, guardados hasheados y con rotación.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address") @db.VarChar(60)
  userAgent String?   @map("user_agent") @db.VarChar(400)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ═════════════════════ Roles y permisos ══════════════════════

/// Perfiles de acceso. Los del sistema no pueden eliminarse.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(60)
  description String? @db.VarChar(300)
  isSystem    Boolean @default(false) @map("is_system")

  status RecordStatus @default(ACTIVE)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, deletedAt])
  @@map("roles")
}

/// Catálogo de capacidades granulares con formato `modulo.accion`.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(80)
  name        String  @db.VarChar(120)
  module      String  @db.VarChar(60)
  description String? @db.VarChar(300)
  isSystem    Boolean @default(false) @map("is_system")

  status RecordStatus @default(ACTIVE)

  roles RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([module])
  @@index([status, deletedAt])
  @@map("permissions")
}

/// Tabla puente entre roles y permisos.
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ═════════════════════════ Docentes ══════════════════════════

/// Personal docente sujeto al control de asistencia.
model Teacher {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique @db.VarChar(40)
  firstName String  @map("first_name") @db.VarChar(120)
  lastName  String  @map("last_name") @db.VarChar(120)
  document  String  @unique @db.VarChar(40)
  email     String  @unique @db.VarChar(200)
  phone     String? @db.VarChar(30)

  /// Ruta pública de la fotografía, servida desde /uploads
  photoUrl String? @map("photo_url") @db.VarChar(300)

  status RecordStatus @default(ACTIVE)

  /// Cuenta con la que el docente entra a marcar su asistencia
  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  subjects    TeacherSubject[]
  schedules   Schedule[]
  attendances Attendance[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, deletedAt])
  @@index([code])
  @@index([lastName, firstName])
  @@map("teachers")
}

// ═══════════════════════ Asignaturas ═════════════════════════

/// Materias que se imparten en la institución.
model Subject {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(40)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(300)

  /// Intensidad horaria semanal
  weeklyHours Int? @map("weekly_hours") @db.SmallInt

  /// Color hexadecimal de identificación en la interfaz
  color String? @default("#4F46E5") @db.VarChar(7)

  status RecordStatus @default(ACTIVE)

  teachers  TeacherSubject[]
  schedules Schedule[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, deletedAt])
  @@index([code])
  @@map("subjects")
}

/// Asignaturas que dicta cada docente (relación muchos a muchos).
model TeacherSubject {
  teacherId String  @map("teacher_id") @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([teacherId, subjectId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

// ═════════════════════════ Jornadas ══════════════════════════

/// Franjas institucionales sobre las que se arman los horarios.
model Shift {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(80)
  description String? @db.VarChar(300)

  status RecordStatus @default(ACTIVE)

  schedules Schedule[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, deletedAt])
  @@map("shifts")
}

// ═════════════════════════ Horarios ══════════════════════════

/// Franja de trabajo de un docente: contra ella se mide la puntualidad.
model Schedule {
  id String @id @default(uuid()) @db.Uuid

  teacherId String  @map("teacher_id") @db.Uuid
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  shiftId String @map("shift_id") @db.Uuid
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Asignatura de la franja. Debe estar entre las que dicta el docente.
  subjectId String?  @map("subject_id") @db.Uuid
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// 0 = domingo … 6 = sábado. `null` aplica a todos los días.
  dayOfWeek Int? @map("day_of_week") @db.SmallInt

  /// Formato HH:mm en hora local institucional
  checkInTime      String @map("check_in_time") @db.VarChar(5)
  checkOutTime     String @map("check_out_time") @db.VarChar(5)
  /// Margen en minutos antes de considerar la entrada como tarde (RN007)
  toleranceMinutes Int    @default(10) @map("tolerance_minutes") @db.SmallInt

  status RecordStatus @default(ACTIVE)

  attendances Attendance[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  // El cruce de franjas lo valida `SchedulesService.assertNoOverlap()`:
  // comprueba solapamiento horario, no solo coincidencia exacta.
  @@index([teacherId, status])
  @@index([teacherId, dayOfWeek])
  @@index([shiftId])
  @@index([subjectId])
  @@map("schedules")
}

// ════════════════════════ Asistencia ═════════════════════════

/// Marcación de entrada o salida. Es la evidencia del sistema.
model Attendance {
  id String @id @default(uuid()) @db.Uuid

  teacherId String  @map("teacher_id") @db.Uuid
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  scheduleId String?   @map("schedule_id") @db.Uuid
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  type   AttendanceType
  status AttendanceStatus

  /// Fecha local de la marcación, sin componente horario
  date DateTime @db.Date

  /// Instante exacto del registro
  registeredAt DateTime @map("registered_at") @db.Timestamptz(3)

  /// Hora esperada según el horario aplicado (HH:mm)
  expectedTime String? @map("expected_time") @db.VarChar(5)

  /// Minutos de diferencia: positivo llegó tarde, negativo se anticipó
  minutesDiff Int @default(0) @map("minutes_diff") @db.SmallInt

  ipAddress String? @map("ip_address") @db.VarChar(60)
  userAgent String? @map("user_agent") @db.VarChar(400)
  device    String? @db.VarChar(120)
  notes     String? @db.VarChar(400)

  /// Quién ejecutó el registro: el propio docente o un administrativo
  registeredById String? @map("registered_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([teacherId, date])
  @@index([date, type])
  @@index([status])
  @@index([scheduleId])
  @@index([deletedAt])
  @@map("attendances")
}

// ════════════════════════ Auditoría ══════════════════════════

/// Bitácora de toda acción del sistema (RN009).
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Se conservan copiados: el evento debe seguir siendo legible
  /// aunque el usuario se elimine más adelante
  userEmail String? @map("user_email") @db.VarChar(180)
  userName  String? @map("user_name") @db.VarChar(240)

  action      AuditAction
  module      String      @db.VarChar(60)
  entityId    String?     @map("entity_id") @db.VarChar(60)
  description String      @db.VarChar(500)

  ipAddress String? @map("ip_address") @db.VarChar(60)
  userAgent String? @map("user_agent") @db.VarChar(400)
  device    String? @db.VarChar(120)

  /// Detalle estructurado del evento, consultable con operadores JSON
  metadata Json? @db.JsonB

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════ Configuración ═══════════════════════

/// Parámetros del sistema editables sin desplegar código.
model Setting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique @db.VarChar(80)
  value String @db.Text

  type SettingType @default(STRING)

  group       String  @default("general") @db.VarChar(60)
  label       String  @db.VarChar(160)
  description String? @db.VarChar(400)
  /// Accesible sin autenticación (nombre institucional, zona horaria)
  isPublic    Boolean @default(false) @map("is_public")
  /// Su modificación exige además tocar la configuración del servidor
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([group])
  @@map("settings")
}
