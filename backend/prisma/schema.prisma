// ──────────────────────────────────────────────────────────────
// Sistema Web de Asistencia Docente por QR
//
// Motor: SQLite. Implicaciones respecto a un motor relacional completo:
//   · No existen ENUM nativos → los campos de estado se guardan como String
//     y se validan contra las enumeraciones de `src/common/enums.ts`.
//   · No existe el tipo JSON → `AuditLog.metadata` se guarda serializado.
//   · No existen tipos nativos (@db.VarChar, @db.Uuid…) → longitudes y
//     formatos se validan en los DTO.
//
// Todas las entidades usan UUID, createdAt, updatedAt y deletedAt
// (soft delete obligatorio).
// ──────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Usuarios ────────────────────────

model User {
  id        String  @id @default(uuid())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  document  String  @unique
  email     String  @unique
  phone     String?
  password  String

  /// RecordStatus: ACTIVE | INACTIVE
  status String @default("ACTIVE")

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")

  teacher       Teacher?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, deletedAt])
  @@index([roleId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// ─────────────────────── Roles y permisos ────────────────────

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  /// RecordStatus: ACTIVE | INACTIVE
  status String @default("ACTIVE")

  users       User[]
  permissions RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, deletedAt])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  /// Formato módulo.acción, ej. users.create
  code        String  @unique
  name        String
  module      String
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  /// RecordStatus: ACTIVE | INACTIVE
  status String @default("ACTIVE")

  roles RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([module])
  @@index([status, deletedAt])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────── Docentes ────────────────────────

model Teacher {
  id        String  @id @default(uuid())
  code      String  @unique
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  document  String  @unique
  email     String  @unique
  phone     String?

  /// Ruta pública de la fotografía, ej. /uploads/teachers/<archivo>.webp
  photoUrl String? @map("photo_url")

  /// RecordStatus: ACTIVE | INACTIVE
  status String @default("ACTIVE")

  /// Vínculo opcional con la cuenta de acceso del docente
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  subjects    TeacherSubject[]
  schedules   Schedule[]
  attendances Attendance[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, deletedAt])
  @@index([code])
  @@map("teachers")
}

// ───────────────────────── Asignaturas ───────────────────────

model Subject {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  /// Intensidad horaria semanal
  weeklyHours Int? @map("weekly_hours")

  /// Color de identificación en la interfaz (hex)
  color String? @default("#4F46E5")

  /// RecordStatus: ACTIVE | INACTIVE
  status String @default("ACTIVE")

  teachers  TeacherSubject[]
  schedules Schedule[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, deletedAt])
  @@index([code])
  @@map("subjects")
}

/// Asignaturas que dicta cada docente (relación muchos a muchos)
model TeacherSubject {
  teacherId String  @map("teacher_id")
  subjectId String  @map("subject_id")
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([teacherId, subjectId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

// ─────────────────────────── Jornadas ────────────────────────

model Shift {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  /// RecordStatus: ACTIVE | INACTIVE
  status String @default("ACTIVE")

  schedules Schedule[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, deletedAt])
  @@map("shifts")
}

// ─────────────────────────── Horarios ────────────────────────

model Schedule {
  id String @id @default(uuid())

  teacherId String  @map("teacher_id")
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  shiftId String @map("shift_id")
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  /// Asignatura que se dicta en esta franja. Debe ser una de las del docente.
  subjectId String?  @map("subject_id")
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  /// 0 = domingo … 6 = sábado. `null` aplica a todos los días.
  dayOfWeek Int? @map("day_of_week")

  /// Formato HH:mm (hora local institucional)
  checkInTime      String @map("check_in_time")
  checkOutTime     String @map("check_out_time")
  toleranceMinutes Int    @default(10) @map("tolerance_minutes")

  /// RecordStatus: ACTIVE | INACTIVE
  status String @default("ACTIVE")

  attendances Attendance[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // La unicidad efectiva la garantiza `SchedulesService.assertNoOverlap()`:
  // valida el cruce de franjas horarias, no solo la coincidencia exacta, y
  // convive con el soft delete (un horario eliminado puede volver a crearse).
  @@index([teacherId, status])
  @@index([teacherId, dayOfWeek])
  @@index([shiftId])
  @@index([subjectId])
  @@map("schedules")
}

// ────────────────────────── Asistencia ───────────────────────

model Attendance {
  id String @id @default(uuid())

  teacherId String  @map("teacher_id")
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  scheduleId String?   @map("schedule_id")
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  /// AttendanceType: CHECK_IN | CHECK_OUT
  type String

  /// AttendanceStatus: ON_TIME | LATE | EARLY_DEPARTURE
  status String

  /// Fecha local de la marcación, anclada a medianoche UTC
  date DateTime

  /// Instante exacto de la marcación
  registeredAt DateTime @map("registered_at")

  /// Hora esperada según horario (HH:mm)
  expectedTime String? @map("expected_time")

  /// Minutos de diferencia: positivo = tarde, negativo = anticipado
  minutesDiff Int @default(0) @map("minutes_diff")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  device    String?
  notes     String?

  registeredById String? @map("registered_by_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([teacherId, date])
  @@index([date, type])
  @@index([status])
  @@map("attendances")
}

// ─────────────────────────── Auditoría ───────────────────────

model AuditLog {
  id String @id @default(uuid())

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  userEmail String? @map("user_email")
  userName  String? @map("user_name")

  /// AuditAction: CREATE | UPDATE | DELETE | ACTIVATE | DEACTIVATE | LOGIN | LOGOUT | ATTENDANCE
  action String

  module      String
  entityId    String? @map("entity_id")
  description String

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  device    String?

  /// JSON serializado (SQLite no tiene tipo JSON nativo)
  metadata String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────── Configuración ─────────────────────

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  /// SettingType: STRING | NUMBER | BOOLEAN | JSON
  type String @default("STRING")

  group       String  @default("general")
  label       String
  description String?
  isPublic    Boolean @default(false) @map("is_public")
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([group])
  @@map("settings")
}
