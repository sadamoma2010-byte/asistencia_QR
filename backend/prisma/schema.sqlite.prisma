// ──────────────────────────────────────────────────────────────
// Esquema de ORIGEN para la migración de datos: la base SQLite
// anterior. Solo se usa para leer durante el traspaso a PostgreSQL.
//
// No lo modifique: describe la estructura tal como quedó guardada
// en backend/prisma/data/app.db. El esquema vigente del sistema es
// schema.prisma.
//
// Genera su cliente en una carpeta aparte para poder tener ambos
// motores abiertos a la vez durante la migración.
// ──────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_URL")
}

model User {
  id        String  @id @default(uuid())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  document  String  @unique
  email     String  @unique
  phone     String?
  password  String
  status    String  @default("ACTIVE")

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")

  teacher       Teacher?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false) @map("is_system")
  status      String  @default("ACTIVE")

  users       User[]
  permissions RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  module      String
  description String?
  isSystem    Boolean @default(false) @map("is_system")
  status      String  @default("ACTIVE")

  roles RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Teacher {
  id        String  @id @default(uuid())
  code      String  @unique
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  document  String  @unique
  email     String  @unique
  phone     String?
  photoUrl  String? @map("photo_url")
  status    String  @default("ACTIVE")

  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  subjects    TeacherSubject[]
  schedules   Schedule[]
  attendances Attendance[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("teachers")
}

model Subject {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  weeklyHours Int?    @map("weekly_hours")
  color       String? @default("#4F46E5")
  status      String  @default("ACTIVE")

  teachers  TeacherSubject[]
  schedules Schedule[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("subjects")
}

model TeacherSubject {
  teacherId String  @map("teacher_id")
  subjectId String  @map("subject_id")
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@id([teacherId, subjectId])
  @@map("teacher_subjects")
}

model Shift {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  status      String  @default("ACTIVE")

  schedules Schedule[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("shifts")
}

model Schedule {
  id String @id @default(uuid())

  teacherId String  @map("teacher_id")
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  shiftId   String  @map("shift_id")
  shift     Shift   @relation(fields: [shiftId], references: [id])
  subjectId String?  @map("subject_id")
  subject   Subject? @relation(fields: [subjectId], references: [id])

  dayOfWeek        Int?   @map("day_of_week")
  checkInTime      String @map("check_in_time")
  checkOutTime     String @map("check_out_time")
  toleranceMinutes Int    @default(10) @map("tolerance_minutes")
  status           String @default("ACTIVE")

  attendances Attendance[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("schedules")
}

model Attendance {
  id String @id @default(uuid())

  teacherId  String    @map("teacher_id")
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  scheduleId String?   @map("schedule_id")
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])

  type   String
  status String

  date         DateTime
  registeredAt DateTime @map("registered_at")
  expectedTime String?  @map("expected_time")
  minutesDiff  Int      @default(0) @map("minutes_diff")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  device    String?
  notes     String?

  registeredById String? @map("registered_by_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("attendances")
}

model AuditLog {
  id String @id @default(uuid())

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  userEmail String? @map("user_email")
  userName  String? @map("user_name")

  action      String
  module      String
  entityId    String? @map("entity_id")
  description String

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  device    String?

  /// En SQLite el JSON se guardaba serializado como texto
  metadata String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("audit_logs")
}

model Setting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String
  type        String  @default("STRING")
  group       String  @default("general")
  label       String
  description String?
  isPublic    Boolean @default(false) @map("is_public")
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("settings")
}
