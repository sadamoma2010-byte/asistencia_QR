NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1

# SQLite: archivo local, ruta relativa a prisma/schema.prisma
DATABASE_URL=file:./data/app.db

JWT_ACCESS_SECRET=cambiar-en-produccion-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-en-produccion-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

LOGIN_RATE_TTL=60
LOGIN_RATE_LIMIT=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=America/Bogota

SEED_ADMIN_EMAIL=admin@datly.local
SEED_ADMIN_PASSWORD=Admin123*
