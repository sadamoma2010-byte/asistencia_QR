{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "python",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["servidor.py"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "start:dev"],
      "port": 4000
    }
  ]
}
