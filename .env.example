# ─────────────────────────────────────────────
# Configuración de la aplicación
#
# Copie este archivo como `.env` y ajuste los valores. La conexión a
# PostgreSQL la escribe sola CONFIGURAR-BASE-DE-DATOS.bat.
#
# `.env` está excluido del repositorio: las credenciales reales no se
# publican nunca.
# ─────────────────────────────────────────────

# ── Base de datos ────────────────────────────
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/asistencia_qr?schema=public

# ── Servidor ─────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1

# Orígenes autorizados a consumir la API desde otro dominio
CORS_ORIGINS=http://localhost:4000

# ── Sesiones ─────────────────────────────────
# Cámbielos antes de publicar en producción: mínimo 32 caracteres
JWT_ACCESS_SECRET=cambiar-en-produccion-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-en-produccion-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Clave de la cookie de sesión del navegador
SESSION_SECRET=cambiar-en-produccion-session-secret-min-32

# ── Seguridad ────────────────────────────────
BCRYPT_ROUNDS=12

# Intentos de acceso permitidos y bloqueo temporal
LOGIN_RATE_TTL=60
LOGIN_RATE_LIMIT=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Institución ──────────────────────────────
# Afecta al cálculo de puntualidad
APP_TIMEZONE=America/Bogota

# ── Usuario inicial ──────────────────────────
SEED_ADMIN_EMAIL=admin@datly.local
