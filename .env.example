# ─────────────────────────────────────────────
# PostgreSQL (usado por docker compose)
# ─────────────────────────────────────────────
POSTGRES_USER=asistencia
POSTGRES_PASSWORD=cambiar_esta_contrasena
POSTGRES_DB=asistencia_qr
POSTGRES_PORT=5432

# ─────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1

JWT_ACCESS_SECRET=cambiar-en-produccion-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-en-produccion-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

# Rate limit del login
LOGIN_RATE_TTL=60
LOGIN_RATE_LIMIT=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

CORS_ORIGINS=http://localhost:3000

# Zona horaria institucional (afecta el cálculo de puntualidad)
APP_TIMEZONE=America/Bogota

# ─────────────────────────────────────────────
# Seed
# ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@datly.local
SEED_ADMIN_PASSWORD=Admin123*

# ─────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sistema de Asistencia Docente
